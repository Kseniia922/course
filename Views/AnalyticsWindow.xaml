<Window x:Class="RestaurantApp.Views.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналітика"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#E5EBF3">


<Window.Resources>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#DCE7F5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#29496D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="105"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="#1769AA"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#C5D4E6"/>
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#C5D4E6"/>
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#183451"/>
        <Setter Property="BorderBrush" Value="#D2DDEA"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E1E8F1"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E1E8F1"/>
        <Setter Property="RowHeight" Value="39"/>
        <Setter Property="ColumnHeaderHeight" Value="42"/>
        <Setter Property="AlternatingRowBackground" Value="#F4F7FB"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E6EDF6"/>
        <Setter Property="Foreground" Value="#173454"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="#D2DDEA"/>
    </Style>

    <Style x:Key="ReportGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

</Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва панель навігації -->
        <Border Grid.Column="0" Background="#172D49">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#12253D">
                    <TextBlock Text="  🍴  RestaurantApp"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="12,0"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="5,15,5,0">

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⌂    Головна"
                            Click="HomeButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="♟    Працівники"
                            Click="EmployeesButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="♨    Страви"
                            Click="MenuButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="◆    Інгредієнти"
                            Click="IngredientButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▤    Рецепти"
                            Click="RecipeButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="₴    Продажі"
                            Click="SalesButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="%    Аналітика"
                            Background="#1769AA"
                            Click="AnalyticsButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>


        <!-- Основна частина -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Аналітика"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#173454"/>

                    <TextBlock Text="Звіти про продажі та популярність страв"
                               FontSize="14"
                               Foreground="#71839A"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Вкладки звітів -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#D5E0ED"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="15">

                <TabControl Background="White"
                            BorderThickness="0"
                            FontSize="14">

                    <TabItem Header="Популярні страви">
                        <Grid Margin="5,15,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Рейтинг страв у кожній категорії"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#173454"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="PopularDishesGrid"
                                      Grid.Row="1"
                                      Style="{StaticResource ReportGridStyle}"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Середні продажі">
                        <Grid Margin="5,15,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Середня кількість проданих порцій за місяць"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#173454"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="AverageSalesGrid"
                                      Grid.Row="1"
                                      Style="{StaticResource ReportGridStyle}"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Продажі за місяцями">
                        <Grid Margin="5,15,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Кількість проданих порцій та загальна сума"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#173454"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="MonthlySalesGrid"
                                      Grid.Row="1"
                                      Style="{StaticResource ReportGridStyle}"/>
                        </Grid>
                    </TabItem>

                    
                    <TabItem Header="Звіт за день">
                        <Grid Margin="5,15,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,12"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Дата:"
                                        VerticalAlignment="Center"
                                        Foreground="#173454"
                                        FontWeight="SemiBold"
                                        Margin="0,0,8,0"/>

                                <DatePicker x:Name="DailySalesDatePicker"
                                            Width="150"
                                            Height="34"/>

                                <Button Content="Показати звіт"
                                        Height="38"
                                        Padding="15,0"
                                        Margin="10,0,0,0"
                                        Background="#1769AA"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="DailySalesButton_Click"/>
                            </StackPanel>

                            <DataGrid x:Name="DailySalesGrid"
                                    Grid.Row="1"
                                    Style="{StaticResource ReportGridStyle}"/>
                        </Grid>
                    </TabItem>

                    
                    <TabItem Header="Зміна цін">
                        <Grid Margin="20">
                            <StackPanel MaxWidth="500"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">

                                <TextBlock Text="Підвищення цін на страви"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#173454"
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Оберіть категорію страв:"
                                        Foreground="#173454"
                                        FontWeight="SemiBold"
                                        Margin="0,10,0,0"/>

                                <ComboBox x:Name="PriceCategoryComboBox"
                                        Height="38"
                                        Margin="0,5,0,10"
                                        DisplayMemberPath="CategoryName"
                                        SelectedValuePath="CategoryName"/>

                                <TextBlock Text="Відсоток підвищення ціни:"
                                        Foreground="#173454"
                                        FontWeight="SemiBold"
                                        Margin="0,5,0,0"/>

                                <TextBox x:Name="PricePercentTextBox"
                                        Height="38"
                                        Margin="0,5,0,15"
                                        Text="10"/>

                                <Button Content="Підвищити ціни"
                                        Style="{StaticResource ActionButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="RaisePricesButton_Click"/>

                                <TextBlock Text="Увага: зміна застосовується до всіх страв обраної категорії."
                                        TextWrapping="Wrap"
                                        Foreground="#71839A"
                                        Margin="0,15,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>