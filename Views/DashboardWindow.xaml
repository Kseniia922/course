
<Window x:Class="RestaurantApp.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Головна"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1150"
        Background="#E5EBF3"
        WindowStartupLocation="CenterScreen">

    
        <Window.Resources>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="48"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#DCE7F5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#29496D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Бокове меню -->
        <Border Grid.Column="0" Background="#172D49">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#12253D">
                    <TextBlock Text="  🍴  RestaurantApp"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="5,15,5,0">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⌂    Головна"
                            Background="#1769AA"
                            Click="HomeButton_Click"/>

                    <Button x:Name="EmployeesNavButton"
                            Content="♟    Працівники"
                            Style="{StaticResource NavButtonStyle}"
                            Click="EmployeesButton_Click"/>

                    <Button Content="♨    Страви"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuButton_Click"/>

                    <Button Content="◆    Інгредієнти"
                            Style="{StaticResource NavButtonStyle}"
                            Click="IngredientButton_Click"/>

                    <Button Content="▤    Рецепти"
                            Style="{StaticResource NavButtonStyle}"
                            Click="RecipeButton_Click"/>

                    <Button x:Name="SalesNavButton"
                            Content="₴    Продажі"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SalesButton_Click"/>

                    <Button x:Name="AnalyticsNavButton"
                            Content="%    Аналітика"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AnalyticsButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Робоча область головної сторінки -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <TextBlock Text="Головна"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#173454"/>

                <TextBlock Text="Огляд роботи ресторану"
                           FontSize="16"
                           Foreground="#526A84"
                           Margin="0,8,0,25"/>

                <!-- Картки статистики -->
                <UniformGrid Columns="2" Margin="0,0,0,15">

                    <Border Background="White"
                            BorderBrush="#D5E0ED"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="♨  Страви"
                                       FontSize="17"
                                       Foreground="#526A84"/>
                            <TextBlock x:Name="DishesCountTextBlock"
                                       Text="0"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#1769AA"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Усього страв у меню"
                                       Foreground="#526A84"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#D5E0ED"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="◆  Інгредієнти"
                                       FontSize="17"
                                       Foreground="#526A84"/>
                            <TextBlock x:Name="IngredientsCountTextBlock"
                                       Text="0"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#1769AA"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Усього інгредієнтів"
                                       Foreground="#526A84"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EmployeesCard"
                            Background="White"
                            BorderBrush="#D5E0ED"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="♟  Працівники"
                                       FontSize="17"
                                       Foreground="#526A84"/>
                            <TextBlock x:Name="EmployeesCountTextBlock"
                                       Text="0"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#1769AA"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Усього працівників"
                                       Foreground="#526A84"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SalesCard"
                            Background="White"
                            BorderBrush="#D5E0ED"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="25">
                        <StackPanel>
                            <TextBlock Text="₴  Продажі"
                                       FontSize="17"
                                       Foreground="#526A84"/>
                            <TextBlock x:Name="SalesCountTextBlock"
                                       Text="0"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#1769AA"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Усього записів про продажі"
                                       Foreground="#526A84"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Background="White"
                        BorderBrush="#D5E0ED"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="22"
                        Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Оберіть потрібний розділ у меню ліворуч, щоб працювати з даними ресторану."
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Foreground="#526A84"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>