
<Window x:Class="RestaurantApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід до RestaurantApp"
        Height="500"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#E5EBF3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя часть окна -->
        <Border Grid.Row="0" Background="#172D49">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="🍴 RestaurantApp"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Система керування рестораном"
                           FontSize="14"
                           Foreground="#DCE7F5"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1"
                    Margin="40,25,40,20">

            <TextBlock Text="Авторизація"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#173454"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,22"/>

            <TextBlock Text="Логін"
                       FontSize="14"
                       Foreground="#173454"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="UsernameTextBox"
                     Height="38"
                     FontSize="15"
                     Padding="10,7"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Пароль"
                       FontSize="14"
                       Foreground="#173454"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="PasswordInput"
                         Height="38"
                         FontSize="15"
                         Padding="10,7"
                         Margin="0,0,0,25"/>

            <Button Content="Увійти"
                    Height="43"
                    Background="#1769AA"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

        </StackPanel>
    </Grid>
</Window>