
<Window x:Class="RestaurantApp.Views.DishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Меню"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1150"
        Background="#E5EBF3"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE7F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#29496D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>


        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C8D3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#C8D3E0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#173454"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EBF3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF1F5"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF2F8"/>
            <Setter Property="Foreground" Value="#173454"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Бокове меню -->
        <Border Grid.Column="0" Background="#172D49">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#12253D">
                    <TextBlock Text="  🍴  RestaurantApp"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="12,0"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="5,15,5,0">

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⌂    Головна"
                            Click="HomeButton_Click"/>

                    <Button x:Name="EmployeesNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="♟    Працівники"
                            Click="EmployeesButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="♨    Страви"
                            Background="#1769AA"
                            Click="MenuButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="◆    Інгредієнти"
                            Click="IngredientButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▤    Рецепти"
                            Click="RecipeButton_Click"/>

                    <Button x:Name="SalesNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="₴    Продажі"
                            Click="SalesButton_Click"/>

                    <Button x:Name="AnalyticsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="%    Аналітика"
                            Click="AnalyticsButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>


        <!-- Рабочая область -->
        <Grid Grid.Column="1" Margin="26,22,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Страви"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#173454"/>
                    <TextBlock Text="Керування меню ресторану"
                               FontSize="14"
                               Foreground="#71839A"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Форма блюда -->
            <Border x:Name="DishFormBorder"
                    Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Інформація про страву"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173454"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Назва страви:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#405570"/>

                        <TextBox x:Name="DishNameTextBox"
                                 Grid.Column="1"/>

                        <TextBlock Text="Категорія:"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#405570"/>

                        <ComboBox x:Name="CategoryComboBox"
                                  Grid.Column="3"
                                  DisplayMemberPath="CategoryName"/>

                        <TextBlock Text="Вага, г:"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#405570"/>

                        <TextBox x:Name="WeightTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"/>

                        <TextBlock Text="Ціна:"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#405570"/>

                        <TextBox x:Name="PriceTextBox"
                                 Grid.Row="1"
                                 Grid.Column="3"/>

                        <TextBlock Text="Опис:"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#405570"/>

                        <TextBox x:Name="DescriptionTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Height="42"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>

                        
                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="AddButton"
                                Content="＋  Додати"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="AddButton_Click"/>

                            <Button x:Name="UpdateButton"
                                    Content="▣  Зберегти зміни"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="UpdateButton_Click"/>

                            <Button x:Name="DeleteButton"
                                    Content="▤  Видалити"
                                    Background="#385675"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="DeleteButton_Click"/>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Таблица блюд -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список страв"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173454"
                               Margin="3,0,0,12"/>

                    <DataGrid x:Name="DishesGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="DishesGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва страви"
                                                Binding="{Binding DishName}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Категорія"
                                                Binding="{Binding CategoryName}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="Вага, г"
                                                Binding="{Binding Weight}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Ціна"
                                                Binding="{Binding Price}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Опис"
                                                Binding="{Binding Description}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
