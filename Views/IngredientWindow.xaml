<Window x:Class="RestaurantApp.Views.IngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інгредієнти"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1150"
        Background="#E5EBF3"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Стиль кнопок бокового меню -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE7F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#29496D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль кнопок дій -->
        <Style x:Key="ActionButtonStyle"
            TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Бокове меню -->

        <Border Grid.Column="0"
                Background="#172D49">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>


                <!-- Назва застосунку -->

                <Border Grid.Row="0"
                        Background="#12253D">

                    <TextBlock Text="  🍴  RestaurantApp"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="12,0"/>

                </Border>


                <!-- Навігація -->

                <StackPanel Grid.Row="1"
                            Margin="5,15,5,0">

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⌂    Головна"
                            Click="HomeButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="♟    Працівники"
                            Click="EmployeesButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="♨    Страви"
                            Click="MenuButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="◆    Інгредієнти"
                            Background="#1769AA"
                            Click="IngredientButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▤    Рецепти"
                            Click="RecipeButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="₴    Продажі"
                            Click="SalesButton_Click"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="%    Аналітика"
                            Click="AnalyticsButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        
        <!-- Робоча область -->

        <Grid Grid.Column="1" Margin="25,20,25,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Інгредієнти"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#173454"/>

                    <TextBlock Text="Керування інгредієнтами ресторану"
                            FontSize="14"
                            Foreground="#71839A"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Форма інгредієнта -->

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#D5E0ED"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="20"
                    Margin="0,0,0,14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>

                    <!-- Назва -->

                    <TextBlock Text="Назва:"
                            VerticalAlignment="Center"
                            Foreground="#173454"
                            FontWeight="SemiBold"/>

                    <TextBox x:Name="IngredientNameTextBox"
                            Grid.Column="1"
                            Height="34"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip="Введіть назву інгредієнта"/>

                    <!-- Категорія -->

                    <TextBlock Text="Категорія:"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#173454"
                            FontWeight="SemiBold"/>

                    <ComboBox x:Name="IngredientCategoryComboBox"
                            Grid.Column="3"
                            Height="34"
                            VerticalContentAlignment="Center"
                            ToolTip="Оберіть категорію"/>

                    <!-- Одиниця виміру -->

                    <TextBlock Text="Одиниця виміру:"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Foreground="#173454"
                            FontWeight="SemiBold"/>

                    <ComboBox x:Name="MeasuringComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="34"
                            VerticalContentAlignment="Center"
                            ToolTip="Оберіть одиницю виміру"/>

                    <!-- Кнопки -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="AddButton"
                                Content="＋  Додати"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="AddButton_Click"/>

                        <Button x:Name="UpdateButton"
                                Content="▣  Зберегти зміни"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="UpdateButton_Click"/>

                        <Button x:Name="DeleteButton"
                                Content="▤  Видалити"
                                Background="#385675"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Таблиця інгредієнтів -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D5E0ED"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10">

                <DataGrid x:Name="IngredientsGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeRows="False"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectionChanged="IngredientsGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва"
                                            Binding="{Binding IngredientName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Категорія"
                                            Binding="{Binding IngredientCategory}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Одиниця виміру"
                                            Binding="{Binding Measuring}"
                                            Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

    </Grid>

</Window>